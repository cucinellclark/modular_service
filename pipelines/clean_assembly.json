{
  "schema": "modpipe/pipeline/v1",
  "name": "Host-removed genome assembly",
  "description": "Remove host (human) reads with Hostile -> fastp trimming -> SPAdes -> QUAST. For clinical isolates/samples.",
  "inputs": {"reads": {"type": "reads.short.paired", "source": {"paired_end_libs": [{"read1": "/user@bvbrc/home/reads/S_R1.fastq.gz", "read2": "/user@bvbrc/home/reads/S_R2.fastq.gz"}]}}},
  "steps": {
    "dehost":   {"module": "hostile", "in": {"reads": "$inputs.reads"}},
    "trim":     {"module": "fastp", "in": {"reads": "dehost.clean_reads"}},
    "assemble": {"module": "spades", "in": {"reads": "trim.trimmed_reads"}, "params": {"mode": "isolate"}},
    "qc":       {"module": "quast", "in": {"contigs": "assemble.contigs"}}
  },
  "outputs": {"contigs": "assemble.contigs", "host_removal_report": "dehost.report", "trim_report": "trim.report_html",
              "qc_report": "qc.report", "qc_metrics": "qc.metrics"},
  "template": {"label": "Host-removed assembly (Hostile + SPAdes)", "category": "assembly",
               "expose": ["dehost.params.index", "assemble.params.mode", "trim.params.qualified_quality_phred", "qc.params.min_contig"]}
}

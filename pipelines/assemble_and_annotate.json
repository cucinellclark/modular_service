{
  "schema": "modpipe/pipeline/v1",
  "name": "Assemble and annotate",
  "description": "fastp trimming -> SPAdes assembly -> BV-BRC Genome Annotation (the BV-BRC service, run whole; the genome is indexed as a private BV-BRC genome)",
  "inputs": {
    "reads": {
      "type": "reads.short.paired",
      "source": {"paired_end_libs": [{"read1": "/user@bvbrc/home/reads/S1_R1.fastq.gz", "read2": "/user@bvbrc/home/reads/S1_R2.fastq.gz"}]},
      "attributes": {"platform": "illumina"}
    }
  },
  "steps": {
    "trim": {"module": "fastp", "in": {"reads": "$inputs.reads"}},
    "assemble": {"module": "spades", "in": {"reads": "trim.trimmed_reads"}, "params": {"mode": "isolate"}},
    "annotate": {"module": "genome_annotation", "in": {"contigs": "assemble.contigs"},
                 "params": {"scientific_name": "Unknown bacterium", "code": 11}}
  },
  "outputs": {
    "contigs": "assemble.contigs",
    "genome": "annotate.genome",
    "genbank": "annotate.genbank",
    "proteins": "annotate.proteins",
    "features": "annotate.features",
    "genome_id": "annotate.genome_id"
  },
  "template": {
    "label": "Assemble and annotate (BV-BRC Genome Annotation)",
    "category": "annotation",
    "expose": ["annotate.params.scientific_name", "annotate.params.taxonomy_id", "annotate.params.code",
               "annotate.params.domain", "assemble.params.mode"]
  }
}
